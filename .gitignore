# Environment
.env

# WordPress export files — 214MB raw, see docs/migration.md
migration/*
!migration/.gitkeep
*.wxr

# Content and plugins live on the Railway volume, managed in the admin —
# only the theme and mu-plugins are owned by this repository.
wp-content/uploads/
wp-content/plugins/
wp-content/upgrade/
wp-content/languages/
# NextGEN: gallery/ is its image store, ngg/ the directory it creates for module
# overrides. Both are 1.5GB of volume state, not repository content.
wp-content/gallery/
wp-content/ngg/

# Local tooling
.claude/settings.local.json

# macOS
.DS_Store
